# Server-only Resend configuration for verified contact messages.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Monik Portfolio <contact@monikportfolio.tech>"
CONTACT_RECIPIENT_EMAIL=

# Optional server-only EmailJS fallback used only when Resend reports a
# daily or monthly sending quota error. Never prefix these with NEXT_PUBLIC_.
EMAILJS_SERVICE_ID=
EMAILJS_CONTACT_TEMPLATE_ID=
EMAILJS_VERIFICATION_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Server-only Upstash Redis REST credentials for OTPs and rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server-only credential for higher GitHub API rate limits.
GITHUB_TOKEN=

# Set to true only after HTTPS is confirmed for the production deployment.
ENABLE_HSTS=false
