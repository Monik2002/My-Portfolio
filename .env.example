# Server-only Resend configuration for verified contact messages.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Monik Portfolio <contact@monikportfolio.tech>"
CONTACT_RECIPIENT_EMAIL=

# Server-only Upstash Redis REST credentials for OTPs and rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server-only Hunter email precheck credential.
HUNTER_API_KEY=

# Optional server-only credential for higher GitHub API rate limits.
GITHUB_TOKEN=

# Set to true only after HTTPS is confirmed for the production deployment.
ENABLE_HSTS=false
